# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database — must point at a Postgres DB you've already created
# (createdb safariadv_db  OR  CREATE DATABASE safariadv_db; in psql)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safariadv_db

# JWT
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# First admin account, created by seed.py
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@safariadv.test
ADMIN_PASSWORD=change-this-password

# Password reset token lifetime (minutes)
RESET_TOKEN_EXPIRES_MINUTES=30

# Mail (optional in dev — if unset, mailer.py silently no-ops on send failure)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=SafariADV <[email protected]>
