# Base URL of the Flask API, including the /api prefix.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional overrides for the weather widget's Open-Meteo endpoints (no API
# key needed - these already default to Open-Meteo's public URLs).
# VITE_GEOCODING_API_BASE=https://geocoding-api.open-meteo.com/v1
# VITE_FORECAST_API_BASE=https://api.open-meteo.com/v1
# VITE_HISTORICAL_API_BASE=https://archive-api.open-meteo.com/v1
