FLASK_APP=run.py
FLASK_ENV=development

# --- Core ---
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string
DATABASE_URL=postgresql://username:password@localhost:5432/safariadv_db
CORS_ORIGINS=http://localhost:5173

# --- First admin account, created by seed.py ---
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@safariadv.com
ADMIN_PASSWORD=change-this-password

# --- Password reset token lifetime, in seconds (used by app/utils/tokens.py) ---
RESET_TOKEN_MAX_AGE=3600

# --- JWT access token lifetime, in seconds ---
JWT_ACCESS_TOKEN_EXPIRES=86400

# --- Mail (optional in dev — if unset, mailer.py silently no-ops) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@safariadv.com

# --- Frontend base URL, used to build the password-reset link sent by email ---
FRONTEND_URL=http://localhost:5173

# --- M-Pesa Daraja (STK Push) ---
# "sandbox" while testing, "production" once you have live credentials.
MPESA_ENV=sandbox
# From your app at https://developer.safaricom.co.ke (Daraja > My Apps).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox defaults below are Safaricom's own published test shortcode/
# passkey and work with no setup. For production, replace both with your
# Paybill/Till number and its Lipa Na M-Pesa Online passkey.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a PUBLICLY reachable HTTPS URL - Safaricom POSTs the payment
# result here (POST /api/payments/mpesa/callback). localhost will not
# work: use your deployed backend URL, or a tunnel (e.g. `ngrok http 5000`)
# while developing locally.
MPESA_CALLBACK_URL=https://your-backend-domain.example/api/payments/mpesa/callback
